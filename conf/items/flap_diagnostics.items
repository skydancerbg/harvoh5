// The roll-up, so one subscription answers "is any flap in trouble?" -- the same
// shape as anyTemperatureAlarm, and for the same reason: a notification should
// need one binding, not eighteen.
Group  gFlapStatus     "Flap status"
Switch anyFlapFault    "Неизправност по клапите [%s]"  (gPersist_On_Every_Change)
