sitemap dev label="ПЪРВОНАЧАЛЕН ПУСК ЗА СЕЗОНА" {


        

        // ================================================================
        //  ONE BUTTON. Does the whole of handbook §4 in a single press:
        //  seeds any missing global, disables every tunnel, kills every lamp,
        //  copies the globals into all 18 tunnels, clears the latched
        //  switches below, and clears itself after 5 s.
        //  Rule: rules/season_start.rules (generated, see make_season_start_rule.py)
        // ================================================================
        Frame label="ПУСК НА СИСТЕМАТА ЗА СЕЗОНА" {
            Text item=seasonStartedAt icon="time"  visibility=[seasonStartCount>0]
            Text item=seasonStartCount icon="none" visibility=[seasonStartCount>0]
            Text item=seasonStartInfo icon="none"  visibility=[seasonStartCount>0]
            Text label="Системата още не е пускана за сезона." icon="time" visibility=[seasonStartCount==0]
            Text item=none
            Switch item=seasonStart label="ПУСК / РЕСТАРТ НА СИСТЕМАТА ЗА СЕЗОНА" icon="switch"  labelcolor=[seasonStart=="ON"="orange"]
            Text item=none
            Text label="ВНИМАНИЕ: нулира и РАБОТЕЩИ тунели. Не го натискайте при заредени колички." icon="error"
            Text label="След спиране на тока НЕ е нужно! Таймерите се възстановяват сами." icon="error"
            Text item=none
            Text label="Кога и как се използва - натиснете тук за пълно обяснение" icon="text" {

                Frame label="КОГА СЕ ИЗПОЛЗВА" {
                    Text label="1. Веднъж в началото на сезона, преди първата количка." icon="none"
                    Text label="2. След пълно спиране на цеха, когато ВСИЧКИ тунели са празни." icon="none"
                    Text label="Друг случай почти няма. Ако се колебаете - не го натискайте." icon="none"
                }

                Frame label="КАК СЕ ИЗПОЛЗВА" {
                    Text label="1. Проверете, че всички тунели са празни." icon="none"
                    Text label="2. Натиснете бутона веднъж. Светва оранжево за 2 сек. и се връща сам." icon="none"
                    Text label="3. Готово: всички тунели изключени, лампите угасени, таймери 120 мин." icon="none"
                    Text label="4. Пускайте тунелите ЕДИН ПО ЕДИН от УПРАВЛЕНИЕ СИГНАЛИЗАЦИЯ," icon="none"
                    Text label="   когато тунелът е загрят и зареден с колички." icon="none"
                }

                Frame label="КОГА НЕ СЕ ИЗПОЛЗВА" {
                    Text label="НЕ при количка вътре - нулира таймера и количката остава без отчет." icon="error"
                    Text label="НЕ след спиране на тока. Системата пази и възстановява таймерите" icon="error"
                    Text label="   сама. Натискането ще изтрие точно това, което е възстановено." icon="error"
                    Text label="НЕ за един проблемен тунел - виж следващата точка." icon="error"
                }

                Frame label="ЗА ЕДИН ТУНЕЛ" {
                    Text label="Отворете МАСТЕР РЕСЕТ и натиснете Тунел N RESET." icon="none"
                    Text label="Той нулира САМО този тунел и не пипа останалите." icon="none"
                }

                Frame label="КАКВО ПИШЕ НАД БУТОНА" {
                    Text label="Последен пуск - датата на последното натискане." icon="none"
                    Text label="Пускания за сезона - колко пъти е натискан. Нормално е 1." icon="none"
                    Text label="Последният пуск беше - чист старт, или с работещи тунели и кои." icon="none"
                    Text label="Ако видите дата отпреди седмици, сезонът вече е започнал." icon="none"
                }
            }
        }

        Frame label="РЪЧНА НАСТРОЙКА (за техник)" {


            Switch item=globalInit       label="Global initial INIT all tunnel values!"  labelcolor=[globalInit=="ON"="orange"]
            Switch item=sw_init_default_tnl_warn_timer_setpoint label="Init yellow collor display below x minutes"  labelcolor=[sw_init_default_tnl_warn_timer_setpoint=="ON"="orange"]
            Switch item=sw_init_default_tnl_temperature_alarm_setpoint label="Init temperature alarm setpoint value"  labelcolor=[sw_init_default_tnl_temperature_alarm_setpoint=="ON"="orange"]

            Text item=none                  
            Text item=none                  
            Switch item=enableAllTunnels label="Global ENABLE all tunnels!"  labelcolor=[enableAllTunnels=="ON"="orange"]
            Switch item=disableAllTunnels label="Global DISABLE all tunnels!"  labelcolor=[disableAllTunnels=="ON"="orange"]

            Text item=none                  
            Text item=none  
            Text item=none
            Setpoint item=default_tnl_timer_value                       label="Глобално: Таймер времеза сушене  [%d минути]" icon="time" minValue=1 maxValue=1440 step=1
            Setpoint item=default_tnl_timer_missed_action_value        label="Глобално: Таймер аларма при бездействие [%d минути]" icon="time" minValue=1 maxValue=1440 step=1
            Setpoint item=default_tnl_timer_extendedDryingTime_value    label="Глобално: Допълнително време за сушене  [%d минути]" icon="time" minValue=1 maxValue=1440 step=1    
            Text item=none
            Text item=none
            Setpoint item=default_tnl_warn_timer_value    label="Глобално: Оцвети дисплей в жълто при оставащи  [%d минути]" icon="time" minValue=1 maxValue=1440 step=1
            Setpoint item=default_tnl_temperature_alarm_value    label="Глобално: Настройка аларма при висока температура  [%.1f °C]" icon="time" minValue=1 maxValue=120 step=1
            Text item=none
            Text item=none
            Text item=none
            Text item=none
        Switch item=tnl_1_btnctrl_enable
        Switch item=tnl_2_btnctrl_enable
        Switch item=tnl_3_btnctrl_enable
        Switch item=tnl_4_btnctrl_enable
        Switch item=tnl_5_btnctrl_enable
        Switch item=tnl_6_btnctrl_enable
        Switch item=tnl_7_btnctrl_enable
        Switch item=tnl_8_btnctrl_enable
        Switch item=tnl_9_btnctrl_enable
        Switch item=tnl_10_btnctrl_enable
        Switch item=tnl_11_btnctrl_enable
        Switch item=tnl_12_btnctrl_enable
        Switch item=tnl_13_btnctrl_enable
        Switch item=tnl_14_btnctrl_enable
        Switch item=tnl_15_btnctrl_enable
        Switch item=tnl_16_btnctrl_enable
        Switch item=tnl_17_btnctrl_enable
        Switch item=tnl_18_btnctrl_enable

            Text item=none
            Text item=none
            Text item=tnl_1_current_timer_value     label="[%.1f минути]"
            Text item=tnl_2_current_timer_value     label="[%.1f минути]"
            Text item=tnl_3_current_timer_value     label="[%d минути]"
            Text item=tnl_4_current_timer_value     label="[%d минути]"
            Text item=tnl_5_current_timer_value     label="[%d минути]"
            Text item=tnl_6_current_timer_value     label="[%d минути]"
            Text item=tnl_7_current_timer_value     label="[%d минути]"
            Text item=tnl_8_current_timer_value     label="[%d минути]"
            Text item=tnl_9_current_timer_value     label="[%d минути]"
            Text item=tnl_10_current_timer_value    label="[%d минути]"
            Text item=tnl_11_current_timer_value    label="[%d минути]"
            Text item=tnl_12_current_timer_value    label="[%d минути]"
            Text item=tnl_13_current_timer_value    label="[%d минути]"
            Text item=tnl_14_current_timer_value    label="[%d минути]"
            Text item=tnl_15_current_timer_value    label="[%d минути]"
            Text item=tnl_16_current_timer_value    label="[%d минути]"
            Text item=tnl_17_current_timer_value    label="[%d минути]"
            Text item=tnl_18_current_timer_value    label="[%d минути]"

            
            // REMOVE tnis setting for individual tunnels
            // Setpoint item=tnl_51_timer_missed_action_value     label="Тунел 51 - Таймер пропуснато действие[%d минути]" icon="time" minValue=1 maxValue=1440 step=1                                    
