            mappings=[ON="ВКЛ.", OFF="ИЗКЛ."]
            visibility=[tnl_16_btnctrl_enable==OFF]

        Switch item=tnl_16_btnctrl_enable
            label="Автоматизация"
            icon="light-on"
            mappings=[ON="ВКЛ.", OFF="ИЗКЛ."]
            visibility=[tnl_16_btnctrl_enable==ON]

        Switch item=tnl_16_resetTimer_sw
            label="Рестарт"
            icon="reset"
            mappings=[ON="РЕСТАРТ"]
            visibility=[tnl_16_btnctrl_enable==ON]

        Setpoint item=tnl_16_current_timer_value
            label="Таймер [%d мин]"
            icon="timeonclassic"
            valuecolor=[>10="green",>0="orange",<=0="red"]
            minValue=-1440 maxValue=1440 step=5
            visibility=[tnl_16_btnctrl_enable==ON]

        Setpoint item=tnl_16_timer_default_value
            label="Основно време [%d мин]"
            icon="settings"
            minValue=1 maxValue=1440 step=1
            visibility=[tnl_16_btnctrl_enable==ON]

        Setpoint item=tnl_16_timer_extendedDryingTime_value
            label="Доп. време [%d мин]"
            icon="settings"
            minValue=1 maxValue=1440 step=1
            visibility=[tnl_16_btnctrl_enable==ON]

