// ============================================================================
//  flap_init.rules -- give the flap sliders a position instead of NaN
// ============================================================================
//  GENERATED by make_generated_rules.py -- edit that, not this file.
//
//  THE PROBLEM
//  -----------
//  The HABPanel flap pages bind their slider to FlapActuator_N_Target.  That
//  Item is only ever written by an operator dragging the slider: it sits in
//  gPersist_On_Change_1minute, which has NO restoreOnStartup, and on OH5 its
//  MQTT channel is commented out entirely (read-only mode).  So after every
//  restart all 19 Targets are NULL, and a slider bound to NULL renders as
//  "NaNmm" pinned to the bottom of its travel -- on all eighteen at once.
//
//  THE FIX
//  -------
//  When a Target is NULL, seed it from what the potentiometer actually reports
//  (FlapActuator_N_Current), so the slider opens where the flap really is.
//
//  postUpdate, NEVER sendCommand.  postUpdate sets openHAB's own state and puts
//  the slider in the right place; sendCommand would go out on cmnd/ and order a
//  real actuator to move.  On OH5 that is inert today, but this same file runs
//  on production where those channels are live, and seeding must never drive
//  anything.
//
//  ONLY when the reading is a plausible position, 0..200 mm.  Seven of the
//  nineteen pots have reported impossible values (-51, 274, 490) and five are
//  offline entirely.  Inventing a position for those would put a confident
//  number under a flap nobody can see -- worse than an obviously broken display.
//  Those sliders stay NaN, and the redesigned tile above them says so in red.
//
//  Runs at startup, at season start, AND on the minute tick -- the last one so
//  that a flap which comes back online has its slider populated within a minute
//  instead of at the next restart.  It only ever acts on a NULL Target, so it
//  can never overwrite an operator's setting.
// ============================================================================

rule "Flap sliders - seed target from the reported position"
when
    Item SystemStarting changed to OFF or
    Item seasonStart received command ON or
    Item oneMinuteTriggerSwitch changed
then
    var int seeded = 0
    var int blind  = 0

    if(FlapActuator_1_Target.state == NULL || FlapActuator_1_Target.state == UNDEF) {
        if(FlapActuator_1_Current.state instanceof DecimalType) {
            val double p1 = (FlapActuator_1_Current.state as DecimalType).doubleValue
            if(p1 >= 0.0 && p1 <= 200.0) {
                FlapActuator_1_Target.postUpdate(p1)
                seeded = seeded + 1
            } else {
                blind = blind + 1
            }
        } else {
            blind = blind + 1
        }
    }
    if(FlapActuator_2_Target.state == NULL || FlapActuator_2_Target.state == UNDEF) {
        if(FlapActuator_2_Current.state instanceof DecimalType) {
            val double p2 = (FlapActuator_2_Current.state as DecimalType).doubleValue
            if(p2 >= 0.0 && p2 <= 200.0) {
                FlapActuator_2_Target.postUpdate(p2)
                seeded = seeded + 1
            } else {
                blind = blind + 1
            }
        } else {
            blind = blind + 1
        }
    }
    if(FlapActuator_3_Target.state == NULL || FlapActuator_3_Target.state == UNDEF) {
        if(FlapActuator_3_Current.state instanceof DecimalType) {
