            a12 = false
            logInfo("temperature_alarm", "tunnel 12 back to normal ({} C)", t12)
        }
    }
    if(a12) inAlarm = inAlarm + 1

    // ---- tunnel 13 ----
    //  a13 tracks the INTENDED alarm state.  It is not re-read from the Item
    //  after a postUpdate, because postUpdate is asynchronous -- the Item still
    //  reads its old value for the rest of this rule execution.  Counting the
    //  roll-up off the Item instead of off this flag left anyTemperatureAlarm
    //  stuck ON for a whole minute after the last tunnel had cleared.
    var boolean a13 = (tnl_13_temperature_alarm.state == ON)
    var double t13i = -999.0
    var double t13o = -999.0
    if(in_13_Temperature.state instanceof DecimalType)  t13i = (in_13_Temperature.state as DecimalType).doubleValue
    if(out_13_Temperature.state instanceof DecimalType) t13o = (out_13_Temperature.state as DecimalType).doubleValue
    if(t13i <= -50.0 || t13i >= 500.0) t13i = -999.0
    if(t13o <= -50.0 || t13o >= 500.0) t13o = -999.0
    if(t13i > -998.0 || t13o > -998.0) {
        val double t13 = if(t13i > t13o) t13i else t13o
        var int c13 = 0
        if(tempOverCount.get("13") !== null) c13 = tempOverCount.get("13")
        if(t13 > threshold) c13 = c13 + 1 else c13 = 0
        tempOverCount.put("13", c13)
        if(c13 >= 2 && !a13) {
            tnl_13_temperature_alarm.postUpdate(ON)
            a13 = true
            logWarn("temperature_alarm", "!!! ТУНЕЛ 13 ПРЕГРЯВАНЕ / OVER TEMPERATURE: cold={} C warm={} C threshold={} C", t13i, t13o, threshold)
        }
        if(t13 < clearBelow && a13) {
            tnl_13_temperature_alarm.postUpdate(OFF)
            a13 = false
            logInfo("temperature_alarm", "tunnel 13 back to normal ({} C)", t13)
        }
    }
    if(a13) inAlarm = inAlarm + 1

