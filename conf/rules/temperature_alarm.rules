// ============================================================================
//  temperature_alarm.rules -- the 86 C overheat alarm
// ============================================================================
//  GENERATED by make_generated_rules.py -- edit that, not this file.
//  Variant: OH5 dev instance
//
//  WHY THIS EXISTS
//  ---------------
//  In 2021 the gas burner's OWN sensor failed.  Its independent controller
//  therefore did not know the tunnel was overheating and kept firing; tunnel 10
//  reached 101.9 C.  Our sensors sit outside that control loop, so the rise
//  stayed visible on the operator screens, and operators shut the burner down by
//  hand in time.  Tons of plums saved.  That incident is the entire reason the
//  86 C threshold exists (handbook 7.2).
//
//  Until now the alarm was a COLOUR, computed in the browser by the HABPanel
//  ДИСПЛЕЙ widget.  It existed only while somebody had that page open and was
//  looking at it.  Nothing logged it, nothing persisted it, and there was no
//  history afterwards -- the 2021 event itself could not be reconstructed from
//  alarm data, only from raw temperatures.  The eighteen tnl_N_temperature_alarm
//  Items existed for exactly this purpose and were written by nothing.
//
//  This rule drives them, so the alarm has a server-side state and a history,
//  and anything later -- a notification, a siren, a Grafana panel -- can hang
//  off one Item instead of re-deriving the comparison.
//
//  WHAT IT WILL NOT DO
//  -------------------
//  It will not fire on a bad reading.  Two guards, both from the 2021-24 data:
//    * in_5 and in_12 report 998 as a sensor error code, and isolated
//      one-minute spikes to 121.6/121.7 C are in the history as glitches.  Any
//      sample outside -50.0 .. 500.0 C is not a temperature and is ignored.
//    * a single sample over threshold is not an overheat -- 2 consecutive
//      minutes are required.
//  If BOTH sensors of a tunnel are unreadable the alarm is left exactly as it
//  was: no data is not the same as no alarm.
//
//  Clearing uses 2.0 C of hysteresis, so a tunnel sitting exactly on the
//  threshold does not chatter the alarm on and off every minute.
// ============================================================================

//  How many consecutive minutes each tunnel has been over threshold.
//  Deliberately NOT an Item: it is scratch state, it means nothing after a
//  restart, and 18 more Items is 18 more things to be NULL on an operator page.
var java.util.Map<String, Integer> tempOverCount = newHashMap

rule "Temperature alarm - evaluate every minute"
when
    Item oneMinuteTriggerSwitch changed
then
    if(default_tnl_temperature_alarm_value.state == NULL || default_tnl_temperature_alarm_value.state == UNDEF) {
        logWarn("temperature_alarm", "no alarm threshold set - cannot evaluate")
        return;
    }
    val double threshold  = (default_tnl_temperature_alarm_value.state as DecimalType).doubleValue
    val double clearBelow = threshold - 2.0
    var int inAlarm = 0

    // ---- tunnel 1 ----
    //  a1 tracks the INTENDED alarm state.  It is not re-read from the Item
    //  after a postUpdate, because postUpdate is asynchronous -- the Item still
    //  reads its old value for the rest of this rule execution.  Counting the
    //  roll-up off the Item instead of off this flag left anyTemperatureAlarm
    //  stuck ON for a whole minute after the last tunnel had cleared.
    var boolean a1 = (tnl_1_temperature_alarm.state == ON)
    var double t1i = -999.0
    var double t1o = -999.0
    if(in_1_Temperature.state instanceof DecimalType)  t1i = (in_1_Temperature.state as DecimalType).doubleValue
    if(out_1_Temperature.state instanceof DecimalType) t1o = (out_1_Temperature.state as DecimalType).doubleValue
    if(t1i <= -50.0 || t1i >= 500.0) t1i = -999.0
    if(t1o <= -50.0 || t1o >= 500.0) t1o = -999.0
    if(t1i > -998.0 || t1o > -998.0) {
        val double t1 = if(t1i > t1o) t1i else t1o
        var int c1 = 0
        if(tempOverCount.get("1") !== null) c1 = tempOverCount.get("1")
        if(t1 > threshold) c1 = c1 + 1 else c1 = 0
        tempOverCount.put("1", c1)
        if(c1 >= 2 && !a1) {
            tnl_1_temperature_alarm.postUpdate(ON)
            a1 = true
            logWarn("temperature_alarm", "!!! ТУНЕЛ 1 ПРЕГРЯВАНЕ / OVER TEMPERATURE: cold={} C warm={} C threshold={} C", t1i, t1o, threshold)
        }
        if(t1 < clearBelow && a1) {
            tnl_1_temperature_alarm.postUpdate(OFF)
            a1 = false
            logInfo("temperature_alarm", "tunnel 1 back to normal ({} C)", t1)
        }
    }
    if(a1) inAlarm = inAlarm + 1

    // ---- tunnel 2 ----
    //  a2 tracks the INTENDED alarm state.  It is not re-read from the Item
    //  after a postUpdate, because postUpdate is asynchronous -- the Item still
    //  reads its old value for the rest of this rule execution.  Counting the
    //  roll-up off the Item instead of off this flag left anyTemperatureAlarm
    //  stuck ON for a whole minute after the last tunnel had cleared.
