        }
    }
    if(a17) inAlarm = inAlarm + 1

    // ---- tunnel 18 ----
    //  a18 tracks the INTENDED alarm state.  It is not re-read from the Item
    //  after a postUpdate, because postUpdate is asynchronous -- the Item still
    //  reads its old value for the rest of this rule execution.  Counting the
    //  roll-up off the Item instead of off this flag left anyTemperatureAlarm
    //  stuck ON for a whole minute after the last tunnel had cleared.
    var boolean a18 = (tnl_18_temperature_alarm.state == ON)
    var double t18i = -999.0
    var double t18o = -999.0
    if(in_18_Temperature.state instanceof DecimalType)  t18i = (in_18_Temperature.state as DecimalType).doubleValue
    if(out_18_Temperature.state instanceof DecimalType) t18o = (out_18_Temperature.state as DecimalType).doubleValue
    if(t18i <= -50.0 || t18i >= 500.0) t18i = -999.0
    if(t18o <= -50.0 || t18o >= 500.0) t18o = -999.0
    if(t18i > -998.0 || t18o > -998.0) {
