    //  reads its old value for the rest of this rule execution.  Counting the
    //  roll-up off the Item instead of off this flag left anyTemperatureAlarm
    //  stuck ON for a whole minute after the last tunnel had cleared.
    var boolean a15 = (tnl_15_temperature_alarm.state == ON)
    var double t15i = -999.0
    var double t15o = -999.0
    if(in_15_Temperature.state instanceof DecimalType)  t15i = (in_15_Temperature.state as DecimalType).doubleValue
    if(out_15_Temperature.state instanceof DecimalType) t15o = (out_15_Temperature.state as DecimalType).doubleValue
    if(t15i <= -50.0 || t15i >= 500.0) t15i = -999.0
    if(t15o <= -50.0 || t15o >= 500.0) t15o = -999.0
    if(t15i > -998.0 || t15o > -998.0) {
        val double t15 = if(t15i > t15o) t15i else t15o
        var int c15 = 0
        if(tempOverCount.get("15") !== null) c15 = tempOverCount.get("15")
        if(t15 > threshold) c15 = c15 + 1 else c15 = 0
        tempOverCount.put("15", c15)
        if(c15 >= 2 && !a15) {
            tnl_15_temperature_alarm.postUpdate(ON)
            a15 = true
            logWarn("temperature_alarm", "!!! ТУНЕЛ 15 ПРЕГРЯВАНЕ / OVER TEMPERATURE: cold={} C warm={} C threshold={} C", t15i, t15o, threshold)
        }
        if(t15 < clearBelow && a15) {
            tnl_15_temperature_alarm.postUpdate(OFF)
            a15 = false
            logInfo("temperature_alarm", "tunnel 15 back to normal ({} C)", t15)
        }
    }
    if(a15) inAlarm = inAlarm + 1

    // ---- tunnel 16 ----
    //  a16 tracks the INTENDED alarm state.  It is not re-read from the Item
    //  after a postUpdate, because postUpdate is asynchronous -- the Item still
    //  reads its old value for the rest of this rule execution.  Counting the
    //  roll-up off the Item instead of off this flag left anyTemperatureAlarm
    //  stuck ON for a whole minute after the last tunnel had cleared.
    var boolean a16 = (tnl_16_temperature_alarm.state == ON)
    var double t16i = -999.0
    var double t16o = -999.0
    if(in_16_Temperature.state instanceof DecimalType)  t16i = (in_16_Temperature.state as DecimalType).doubleValue
    if(out_16_Temperature.state instanceof DecimalType) t16o = (out_16_Temperature.state as DecimalType).doubleValue
    if(t16i <= -50.0 || t16i >= 500.0) t16i = -999.0
    if(t16o <= -50.0 || t16o >= 500.0) t16o = -999.0
    if(t16i > -998.0 || t16o > -998.0) {
