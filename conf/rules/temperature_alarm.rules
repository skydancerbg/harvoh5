            logInfo("temperature_alarm", "tunnel 18 back to normal ({} C)", t18)
        }
    }
    if(a18) inAlarm = inAlarm + 1

    // ---- roll-up, so one Item answers "is anything overheating?" ----------
    if(inAlarm > 0 && anyTemperatureAlarm.state != ON) {
        anyTemperatureAlarm.postUpdate(ON)
        logWarn("temperature_alarm", "{} tunnel(s) in temperature alarm", inAlarm)
    }
    if(inAlarm == 0 && anyTemperatureAlarm.state != OFF) {
        anyTemperatureAlarm.postUpdate(OFF)
        logInfo("temperature_alarm", "no tunnel in temperature alarm")
