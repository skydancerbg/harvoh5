    if(t17i <= -50.0 || t17i >= 500.0) t17i = -999.0
    if(t17o <= -50.0 || t17o >= 500.0) t17o = -999.0
    if(t17i > -998.0 || t17o > -998.0) {
        val double t17 = if(t17i > t17o) t17i else t17o
        var int c17 = 0
        if(tempOverCount.get("17") !== null) c17 = tempOverCount.get("17")
        if(t17 > threshold) c17 = c17 + 1 else c17 = 0
        tempOverCount.put("17", c17)
        if(c17 >= 2 && !a17) {
