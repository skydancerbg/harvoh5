// ============================================================================
//  flap_fault.rules -- is each flap actually doing what it was told?
// ============================================================================
//  GENERATED by make_generated_rules.py -- edit that, not this file.
//
//  WHY THIS EXISTS
//  ---------------
//  Asked for by the operator on 2026-08-24: "there might be a fault of an
//  actuator while in season, so we need to warn somehow the operator, maybe
//  comparing desired vs actual position whilst the actuator is not moving with
//  the same hysteresis around the position as it is set in the firmware".
//
//  That is test A below, and it is the core of this file.  The same morning gave
//  us the worked example of why one test is not enough.
//
//  THE CASE THIS WAS BUILT AGAINST
//  -------------------------------
//  Flap 3, 2026-08-24 07:58Z.  Rod stationary, nothing commanding it, and the
//  reported position swung 28 -> 152 -> 36 mm inside 88 seconds while the
//  controller reported `Reject 0%`, `Valid true`, `Health OK`.  It was the
//  sensor, provably: 80 mm in 8 s is 10 mm/s, and the motor was measured at
//  6.5 mm/s on 2026-08-23.  The rod cannot physically do it.
//
//  So `stat/HEALTH` said OK throughout.  HEALTH is the pot's INSTANTANEOUS
//  validity, and this fleet's characteristic failure is drift that passes the
//  acceptance filter -- which means the firmware believes it and would chase it.
//  Any design that colours the page by HEALTH alone would have shown flap 3
//  green while it lied by 124 mm.
//
//  THE FOUR TESTS, AND WHAT EACH ONE ALONE WOULD MISS
//  --------------------------------------------------
//    A. NOT REACHING   device holds a target, mode IDLE, |current - target| >
//                      HYST for two consecutive ticks.  The operator's test.
//                      Catches a seized rod, a lost relay, a dead motor -- and,
//                      in season, a wandering pot too, because a reading that
//                      swings cannot sit inside an 8 mm band.
//    B. UNSTABLE       nothing commanded and nothing moving for the whole
//                      window, yet the reading still spans > WANDER mm.  This is
//                      the only test that catches flap 3 OUT of season, when no
//                      target is standing and test A has nothing to compare.
//    C. SENSOR         HEALTH = FAULT / REPLACE / RECALIBRATE / UNKNOWN.  The
//                      only test that catches a wiper that has gone open circuit
//                      and FROZEN -- flap 7 sat at exactly 199 mm all morning
//                      with its ADC railed at 1..10.  B cannot see a frozen
//                      value; A cannot see it without a target.
//    D. COMMAND LOST   the slider says one thing and the device holds another.
//                      The controller's target lives in RAM only, so a reboot
//                      silently forgets it while openHAB still shows the number
//                      the operator set.
//
//  WHY IT RUNS ON THE MINUTE TICK
//  ------------------------------
//  Same clock as every other countdown in this config, and slow enough that the
//  persistence queries in test B cost nothing.  `tele/STATE` arrives every 30 s,
//  so every input has refreshed at least once between ticks.
//
//  THE TWO-TICK DEBOUNCE, AND WHY IT NEEDS NO COUNTERS
//  ---------------------------------------------------
//  Mode and position come from DIFFERENT topics: Mode from the 30 s tele/STATE
//  snapshot, position from stat/CURRENT_POSITION as it happens.  So Mode can
//  still read IDLE from a stale snapshot while a move is already under way, and
//  a single-tick test would cry wolf on every ordinary command.
//
//  The first offending tick writes ПРОВЕРКА, the second promotes it to
//  НЕ ДОСТИГА.  The Status Item IS the counter -- eighteen DSL globals would
//  otherwise be needed, and globals in this dialect do not survive a reload.
//
//  ⚠️  THIS FILE ONLY EVER CALLS postUpdate.  It must never sendCommand: a fault
//  detector that moves actuators is a fault generator.  On production those
//  channels are live.
// ============================================================================

rule "Flap faults - is each flap achieving the position it was told?"
when
    Item oneMinuteTriggerSwitch changed
then
    var int faults   = 0
    var int deferred = 0
    var int noHist   = 0
    var int quietN   = 0

    try {
        var String st = "ОК"
        val boolean hasMode = FlapActuator_1_Mode.state instanceof StringType
        val boolean hasCur  = FlapActuator_1_Current.state instanceof DecimalType
        val boolean hasTgt  = FlapActuator_1_DeviceTarget.state instanceof DecimalType
        val boolean hasHl   = FlapActuator_1_Health.state instanceof StringType
        val boolean online  = FlapActuator_1_Reachable.state.toString == "Online"
        val String  prev    = FlapActuator_1_Status.state.toString

        // ORDER MATTERS, and it was wrong on the first draft.  Testing `!hasCur`
        // up here called flaps 12, 16 and 18 "НЯМА ВРЪЗКА" -- but all three are
        // online and answering every 30 s; they simply have no wiper fitted.
        // "No controller" and "no sensor" are different faults with different
        // repairs, and only the LWT can tell them apart.
        if(!online || !hasMode) {
            st = "НЯМА ВРЪЗКА"
        } else if(!hasCur || (hasHl && FlapActuator_1_Health.state.toString == "UNKNOWN")) {
            st = "НЯМА ДАТЧИК"                                          // C -- no wiper fitted
        } else {
            val String md   = FlapActuator_1_Mode.state.toString
            val String hl   = if(hasHl) FlapActuator_1_Health.state.toString else "UNKNOWN"
            val double cur  = (FlapActuator_1_Current.state as DecimalType).doubleValue
            val double tgt  = if(hasTgt) (FlapActuator_1_DeviceTarget.state as DecimalType).doubleValue else -1.0

            if(hl == "FAULT" || hl == "REPLACE") {
                st = "ДЕФЕКТЕН СЕНЗОР"                                  // C
            } else if(hl == "RECALIBRATE") {
                // Above the range test on purpose.  RECALIBRATE means the stored
                // end stops may belong to a pot that is no longer fitted, so the
                // mm scale itself is in doubt -- calling that merely "parked out
                // of range" would understate it.  Flap 10 reads 255 mm and
                // RECALIBRATE; the number is not evidence of where the rod is.
                st = "НУЖНА КАЛИБРОВКА"                                 // C
            } else if(md != "IDLE") {
                st = "ДВИЖИ СЕ"                                         // not a fault; suspends A
            } else if(tgt >= 0 && Math::abs(cur - tgt) > 8) {
                // A. The firmware itself would re-enter TRACK at this error, so
                // it is not a band it intends to tolerate -- it is failing to close it.
                st = if(prev == "ПРОВЕРКА" || prev == "НЕ ДОСТИГА") "НЕ ДОСТИГА" else "ПРОВЕРКА"
            } else if(cur > 200 + 8) {
                // A real reading, but outside the range the plant may command.
                // Needs homing, not repair -- do not colour it the same as a fault.
                //
                // The + hyst matters.  Commands are clamped to workMm, so a rod
                // parked at exactly the top of its travel reads a shade over it:
                // flap 7 sat at 202 mm on 2026-08-24 and a bare `> 200` called
                // that a fault.  Two millimetres on a 3 m^2 damper is not one,
                // and the firmware's own band is the honest place to draw it.
                st = if(cur > 350) "ГРЕШНА СТОЙНОСТ" else "ИЗВЪН ОБХВАТ"
            } else {
                // B. Only meaningful when NOTHING has changed for the whole
                // window: if the mode or the target moved, the rod may genuinely
                // have travelled and a wide span proves nothing.
                try {
                    val quiet = !FlapActuator_1_Mode.changedSince(now.minusMinutes(30), "influxdb") &&
                                !FlapActuator_1_DeviceTarget.changedSince(now.minusMinutes(30), "influxdb")
                    if(quiet) {
                        quietN = quietN + 1
                        val mx = FlapActuator_1_Current.maximumSince(now.minusMinutes(30), "influxdb")
                        val mn = FlapActuator_1_Current.minimumSince(now.minusMinutes(30), "influxdb")
                        if(mx !== null && mn !== null) {
                            val double span = (mx.state as DecimalType).doubleValue - (mn.state as DecimalType).doubleValue
                            if(span > 15) st = "НЕСТАБИЛЕН"
                        }
                    }
                } catch(Throwable tp1) {
                    // Persistence unavailable is not a flap fault -- but it must
                    // not be SILENT either.  A swallowed exception here turns
                    // test B into a detector that reports "all well" forever
                    // while checking nothing, which is worse than not having it.
                    // The footer logs the count once per pass.
                    noHist = noHist + 1
                }
                // A marginal wiper that is still inside its acceptance band.
                // Below the position tests because it is a "watch this" and they
                // are "act on this" -- but it must not be silent, which the first
                // draft made it: flap 7 came back from FAULT to DEGRADED during
                // the 2026-08-24 scrub and would have been reported plain ОК.
                if(st == "ОК" && hl == "DEGRADED") st = "СЛАБ СЕНЗОР"
                // D. Checked last so a real position fault always outranks it.
                if(st == "ОК" && FlapActuator_1_Target.state instanceof DecimalType) {
                    val double want = (FlapActuator_1_Target.state as DecimalType).doubleValue
                    if(tgt >= 0 && Math::abs(want - tgt) > 8) st = "КОМАНДА ЗАГУБЕНА"
                }
            }
        }

        if(prev != st) FlapActuator_1_Status.postUpdate(st)
        if(st != "ОК" && st != "ДВИЖИ СЕ" && st != "ПРОВЕРКА") faults = faults + 1
    } catch(Throwable tx1) {
        deferred = deferred + 1
    }

    try {
        var String st = "ОК"
        val boolean hasMode = FlapActuator_2_Mode.state instanceof StringType
        val boolean hasCur  = FlapActuator_2_Current.state instanceof DecimalType
        val boolean hasTgt  = FlapActuator_2_DeviceTarget.state instanceof DecimalType
        val boolean hasHl   = FlapActuator_2_Health.state instanceof StringType
        val boolean online  = FlapActuator_2_Reachable.state.toString == "Online"
