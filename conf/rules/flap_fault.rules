                    if(tgt >= 0 && Math::abs(want - tgt) > 8) st = "КОМАНДА ЗАГУБЕНА"
                }
            }
        }

        if(prev != st) FlapActuator_2_Status.postUpdate(st)
        if(st != "ОК" && st != "ДВИЖИ СЕ" && st != "ПРОВЕРКА") faults = faults + 1
    } catch(Throwable tx2) {
        deferred = deferred + 1
    }

    try {
        var String st = "ОК"
        val boolean hasMode = FlapActuator_3_Mode.state instanceof StringType
