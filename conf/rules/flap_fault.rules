                                !FlapActuator_2_DeviceTarget.changedSince(now.minusMinutes(30), "influxdb")
                    if(quiet) {
                        quietN = quietN + 1
                        val mx = FlapActuator_2_Current.maximumSince(now.minusMinutes(30), "influxdb")
                        val mn = FlapActuator_2_Current.minimumSince(now.minusMinutes(30), "influxdb")
