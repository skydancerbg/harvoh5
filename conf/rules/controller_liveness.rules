    controllerSilentTicks.put("in_1", t_in1)
    if(up_in1) onlineNow = onlineNow + 1
    val boolean sil_in1 = (t_in1 >= 3)
    if(sil_in1 && controllerSilent_in_1.state != ON) controllerSilent_in_1.postUpdate(ON)
    if(!sil_in1 && controllerSilent_in_1.state != OFF) controllerSilent_in_1.postUpdate(OFF)
    if(sil_in1) {
        silent = silent + 1
        silentIn = silentIn + 1
