    if(up_out14) onlineNow = onlineNow + 1
    val boolean sil_out14 = (t_out14 >= 3)
    if(sil_out14 && controllerSilent_out_14.state != ON) controllerSilent_out_14.postUpdate(ON)
    if(!sil_out14 && controllerSilent_out_14.state != OFF) controllerSilent_out_14.postUpdate(OFF)
    if(sil_out14) {
        silent = silent + 1
        silentOut = silentOut + 1
        devs = devs + "тунел 14 топъл, "
    }

    // ---- tunnel 14 IN ----
    val boolean up_in14 = (in_14_Reachable.state.toString == "Online")
    var int t_in14 = 0
    if(controllerSilentTicks.get("in_14") !== null) t_in14 = controllerSilentTicks.get("in_14")
    if(up_in14) t_in14 = 0 else t_in14 = t_in14 + 1
    controllerSilentTicks.put("in_14", t_in14)
    if(up_in14) onlineNow = onlineNow + 1
    val boolean sil_in14 = (t_in14 >= 3)
    if(sil_in14 && controllerSilent_in_14.state != ON) controllerSilent_in_14.postUpdate(ON)
    if(!sil_in14 && controllerSilent_in_14.state != OFF) controllerSilent_in_14.postUpdate(OFF)
    if(sil_in14) {
        silent = silent + 1
        silentIn = silentIn + 1
        devs = devs + "тунел 14 студен, "
    }

    // ---- tunnel 15 OUT ----
    val boolean up_out15 = (out_15_Reachable.state.toString == "Online")
    var int t_out15 = 0
    if(controllerSilentTicks.get("out_15") !== null) t_out15 = controllerSilentTicks.get("out_15")
    if(up_out15) t_out15 = 0 else t_out15 = t_out15 + 1
    controllerSilentTicks.put("out_15", t_out15)
    if(up_out15) onlineNow = onlineNow + 1
    val boolean sil_out15 = (t_out15 >= 3)
    if(sil_out15 && controllerSilent_out_15.state != ON) controllerSilent_out_15.postUpdate(ON)
    if(!sil_out15 && controllerSilent_out_15.state != OFF) controllerSilent_out_15.postUpdate(OFF)
    if(sil_out15) {
        silent = silent + 1
        silentOut = silentOut + 1
        devs = devs + "тунел 15 топъл, "
    }

    // ---- tunnel 15 IN ----
    val boolean up_in15 = (in_15_Reachable.state.toString == "Online")
    var int t_in15 = 0
    if(controllerSilentTicks.get("in_15") !== null) t_in15 = controllerSilentTicks.get("in_15")
    if(up_in15) t_in15 = 0 else t_in15 = t_in15 + 1
    controllerSilentTicks.put("in_15", t_in15)
    if(up_in15) onlineNow = onlineNow + 1
    val boolean sil_in15 = (t_in15 >= 3)
    if(sil_in15 && controllerSilent_in_15.state != ON) controllerSilent_in_15.postUpdate(ON)
    if(!sil_in15 && controllerSilent_in_15.state != OFF) controllerSilent_in_15.postUpdate(OFF)
    if(sil_in15) {
        silent = silent + 1
        silentIn = silentIn + 1
        devs = devs + "тунел 15 студен, "
    }

    // ---- tunnel 16 OUT ----
    val boolean up_out16 = (out_16_Reachable.state.toString == "Online")
    var int t_out16 = 0
    if(controllerSilentTicks.get("out_16") !== null) t_out16 = controllerSilentTicks.get("out_16")
    if(up_out16) t_out16 = 0 else t_out16 = t_out16 + 1
    controllerSilentTicks.put("out_16", t_out16)
    if(up_out16) onlineNow = onlineNow + 1
    val boolean sil_out16 = (t_out16 >= 3)
    if(sil_out16 && controllerSilent_out_16.state != ON) controllerSilent_out_16.postUpdate(ON)
    if(!sil_out16 && controllerSilent_out_16.state != OFF) controllerSilent_out_16.postUpdate(OFF)
    if(sil_out16) {
        silent = silent + 1
        silentOut = silentOut + 1
        devs = devs + "тунел 16 топъл, "
    }

    // ---- tunnel 16 IN ----
    val boolean up_in16 = (in_16_Reachable.state.toString == "Online")
    var int t_in16 = 0
    if(controllerSilentTicks.get("in_16") !== null) t_in16 = controllerSilentTicks.get("in_16")
    if(up_in16) t_in16 = 0 else t_in16 = t_in16 + 1
    controllerSilentTicks.put("in_16", t_in16)
    if(up_in16) onlineNow = onlineNow + 1
    val boolean sil_in16 = (t_in16 >= 3)
    if(sil_in16 && controllerSilent_in_16.state != ON) controllerSilent_in_16.postUpdate(ON)
    if(!sil_in16 && controllerSilent_in_16.state != OFF) controllerSilent_in_16.postUpdate(OFF)
    if(sil_in16) {
        silent = silent + 1
        silentIn = silentIn + 1
        devs = devs + "тунел 16 студен, "
    }

    // ---- tunnel 17 OUT ----
    val boolean up_out17 = (out_17_Reachable.state.toString == "Online")
    var int t_out17 = 0
    if(controllerSilentTicks.get("out_17") !== null) t_out17 = controllerSilentTicks.get("out_17")
    if(up_out17) t_out17 = 0 else t_out17 = t_out17 + 1
    controllerSilentTicks.put("out_17", t_out17)
    if(up_out17) onlineNow = onlineNow + 1
    val boolean sil_out17 = (t_out17 >= 3)
    if(sil_out17 && controllerSilent_out_17.state != ON) controllerSilent_out_17.postUpdate(ON)
    if(!sil_out17 && controllerSilent_out_17.state != OFF) controllerSilent_out_17.postUpdate(OFF)
    if(sil_out17) {
        silent = silent + 1
        silentOut = silentOut + 1
        devs = devs + "тунел 17 топъл, "
    }

    // ---- tunnel 17 IN ----
    val boolean up_in17 = (in_17_Reachable.state.toString == "Online")
    var int t_in17 = 0
    if(controllerSilentTicks.get("in_17") !== null) t_in17 = controllerSilentTicks.get("in_17")
    if(up_in17) t_in17 = 0 else t_in17 = t_in17 + 1
    controllerSilentTicks.put("in_17", t_in17)
    if(up_in17) onlineNow = onlineNow + 1
    val boolean sil_in17 = (t_in17 >= 3)
    if(sil_in17 && controllerSilent_in_17.state != ON) controllerSilent_in_17.postUpdate(ON)
    if(!sil_in17 && controllerSilent_in_17.state != OFF) controllerSilent_in_17.postUpdate(OFF)
    if(sil_in17) {
        silent = silent + 1
        silentIn = silentIn + 1
        devs = devs + "тунел 17 студен, "
    }

    // ---- tunnel 18 OUT ----
    val boolean up_out18 = (out_18_Reachable.state.toString == "Online")
    var int t_out18 = 0
    if(controllerSilentTicks.get("out_18") !== null) t_out18 = controllerSilentTicks.get("out_18")
    if(up_out18) t_out18 = 0 else t_out18 = t_out18 + 1
    controllerSilentTicks.put("out_18", t_out18)
    if(up_out18) onlineNow = onlineNow + 1
    val boolean sil_out18 = (t_out18 >= 3)
    if(sil_out18 && controllerSilent_out_18.state != ON) controllerSilent_out_18.postUpdate(ON)
    if(!sil_out18 && controllerSilent_out_18.state != OFF) controllerSilent_out_18.postUpdate(OFF)
    if(sil_out18) {
        silent = silent + 1
        silentOut = silentOut + 1
        devs = devs + "тунел 18 топъл, "
    }

    // ---- tunnel 18 IN ----
    val boolean up_in18 = (in_18_Reachable.state.toString == "Online")
    var int t_in18 = 0
    if(controllerSilentTicks.get("in_18") !== null) t_in18 = controllerSilentTicks.get("in_18")
    if(up_in18) t_in18 = 0 else t_in18 = t_in18 + 1
    controllerSilentTicks.put("in_18", t_in18)
    if(up_in18) onlineNow = onlineNow + 1
    val boolean sil_in18 = (t_in18 >= 3)
    if(sil_in18 && controllerSilent_in_18.state != ON) controllerSilent_in_18.postUpdate(ON)
    if(!sil_in18 && controllerSilent_in_18.state != OFF) controllerSilent_in_18.postUpdate(OFF)
    if(sil_in18) {
        silent = silent + 1
        silentIn = silentIn + 1
        devs = devs + "тунел 18 студен, "
    }

    // ---- the flap actuators, as the upstream discriminator ----
    //  They sit on the same broker and produced ZERO LWT transitions across the
    //  three days in which the tunnel controllers produced 300.  So if the tunnels
    //  are all silent and the flaps are too, the fault is the broker or our link to
    //  it; if the flaps are still answering, it is upstream of the tunnel APs only.
    var int flapsOnline = 0
    if(FlapActuator_1_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_2_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_3_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_4_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_5_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_6_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_7_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_8_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_9_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_10_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_11_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_12_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_13_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_14_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_15_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_16_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_17_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1
    if(FlapActuator_18_Reachable.state.toString == "Online") flapsOnline = flapsOnline + 1

    // ---- arming: has the fleet been seen recently at all? ----
    //  Refreshed while anything answers, so it freezes at the moment an outage
    //  begins and its age becomes the outage's age.  Refreshed at most once every
    //  5 minutes rather than every tick: on everyChange persistence a DateTime that
    //  always changes would be 1,440 points a day for no extra resolution.
    var boolean armed     = false
    var boolean seenStale = true
    if(controllerFleetLastSeenAt.state instanceof DateTimeType) {
        //  getZonedDateTime() is DEPRECATED on OH5 and logs a validation notice. It
        //  is kept on purpose: it is the only accessor BOTH versions have, and
        //  production is still openHAB 3.1.0.  Same reasoning as season_end.rules.
        val seen = (controllerFleetLastSeenAt.state as DateTimeType).getZonedDateTime
        if(seen.isAfter(now.minusHours(6))) armed = true
        if(seen.isAfter(now.minusMinutes(5))) seenStale = false
    }
    if((onlineNow > 0 || flapsOnline > 0) && seenStale) {
        controllerFleetLastSeenAt.postUpdate(new DateTimeType())
        armed = true
    }

    // ---- scope FIRST, principle 1.6: many at once is ONE fault, not N ----
    var String scope = "NONE"
    if(silent > 0) {
        if(silent >= 36) {
            if(!armed) {
                scope = "OFFSEASON"
            } else if(flapsOnline == 0) {
                scope = "BROKER"
            } else {
                scope = "ALL"
            }
        } else if(silentIn >= 18 && silentOut == 0) {
            scope = "IN_SIDE"
        } else if(silentOut >= 18 && silentIn == 0) {
            scope = "OUT_SIDE"
        } else if(silent >= 6) {
            scope = "MANY"
        } else {
            scope = "DEVICES"
        }
    }

    // ---- the operator-facing line ----
    var String txt = ""
    if(devs.length > 2) devs = devs.substring(0, devs.length - 2)
    if(scope == "BROKER")   txt = "ВРЪЗКАТА С УСТРОЙСТВАТА Е ПРЕКЪСНАТА — няма данни от нито един контролер"
    if(scope == "ALL")      txt = "ВСИЧКИ КОНТРОЛЕРИ МЪЛЧАТ — проверете захранването и мрежата в тунелите"
    if(scope == "IN_SIDE")  txt = "ВСИЧКИ СТУДЕНИ КОНТРОЛЕРИ МЪЛЧАТ — вероятно точката за достъп AP_IN"
    if(scope == "OUT_SIDE") txt = "ВСИЧКИ ТОПЛИ КОНТРОЛЕРИ МЪЛЧАТ — вероятно точката за достъп AP_OUT"
    if(scope == "MANY")     txt = "" + silent + " контролера не отговарят — вероятно обща причина, а не " + silent + " повреди"
    //  Singular and plural are written out rather than fudged with brackets: this
    //  line is read by an operator under pressure, not by an engineer.
    if(scope == "DEVICES" && silent == 1) txt = "Контролер не отговаря: " + devs
    if(scope == "DEVICES" && silent > 1)  txt = "Контролери не отговарят: " + devs

    // ---- write the roll-up ----
    //  Compared through intValue, not against the State directly: a DecimalType and
    //  an int are not comparable with != in this dialect, and the silent comparison
    //  would either fail to build or never match.
    var int prevCount = -1
    if(controllerSilentCount.state instanceof DecimalType) prevCount = (controllerSilentCount.state as DecimalType).intValue
    if(prevCount != silent) controllerSilentCount.postUpdate(new DecimalType(silent))
    if(controllerLinkText.state.toString != txt) controllerLinkText.postUpdate(txt)
    if(controllerLinkScope.state.toString != scope) {
        controllerLinkScope.postUpdate(scope)
        controllerLinkChangedAt.postUpdate(new DateTimeType())
        //  seasonActive CLASSIFIES the record; it does not gate the detector.
        var String season = "СЕЗОН"
        if(seasonActive.state != ON) season = "ИЗВЪН СЕЗОНА (тест)"
        if(scope == "NONE") {
            logInfo("controller_liveness", "all controllers answering again [{}]", season)
        } else {
            logWarn("controller_liveness", "{} ({} silent of 36, flaps online {}) [{}]: {}", scope, silent, flapsOnline, season, txt)
        }
    }
end
