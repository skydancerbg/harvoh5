// ============================================================================
//  controller_liveness.rules -- is each controller still on the bus?
// ============================================================================
//  GENERATED by make_system_health.py -- edit that, not this file.
//
//  🚨 THIS FILE MUST NEVER GATE THE 86 C OVERHEAT ALARM.  It does not read, write
//  or delay temperature_alarm.rules.  A silent controller must never suppress its
//  tunnel's alarm state -- and the reverse matters more: a silent controller means
//  that tunnel has no overheat protection at all.
//
//  ⚠️  postUpdate ONLY, never sendCommand.  A fault detector that moves hardware is
//  a fault generator.  On production these channels are live.
//
//  WHY THE MINUTE TICK AND NOT THE LWT EVENT
//  -----------------------------------------
//  Measured 2026-08-23..24: 132 offline episodes, median 0.4 s, 98 % under 30 s,
//  longest 78 s, none over 5 minutes.  Triggering on the LWT change would have
//  fired 132 times in three days.  Sampling on the tick discards nearly all of it
//  before the 3-tick debounce even applies.
//
//  THE DEBOUNCE COUNTERS ARE VOLATILE, AND THAT IS FINE
//  ----------------------------------------------------
//  A rules reload clears the map, so a fault takes up to
//  3 more minutes to re-latch.  The SILENT state itself is an Item and is
//  persisted with restoreOnStartup, so nothing is lost from the record.

var java.util.Map<String, Integer> controllerSilentTicks = newHashMap

rule "Controller liveness - evaluate every minute"
when
    Item oneMinuteTriggerSwitch changed
then
    var int onlineNow = 0
    var int silent    = 0
    var int silentIn  = 0
    var int silentOut = 0
    var String devs   = ""

    // ---- tunnel 1 OUT ----
    val boolean up_out1 = (out_1_Reachable.state.toString == "Online")
    var int t_out1 = 0
    if(controllerSilentTicks.get("out_1") !== null) t_out1 = controllerSilentTicks.get("out_1")
    if(up_out1) t_out1 = 0 else t_out1 = t_out1 + 1
    controllerSilentTicks.put("out_1", t_out1)
    if(up_out1) onlineNow = onlineNow + 1
    val boolean sil_out1 = (t_out1 >= 3)
    if(sil_out1 && controllerSilent_out_1.state != ON) controllerSilent_out_1.postUpdate(ON)
    if(!sil_out1 && controllerSilent_out_1.state != OFF) controllerSilent_out_1.postUpdate(OFF)
    if(sil_out1) {
        silent = silent + 1
        silentOut = silentOut + 1
        devs = devs + "тунел 1 топъл, "
    }

    // ---- tunnel 1 IN ----
    val boolean up_in1 = (in_1_Reachable.state.toString == "Online")
    var int t_in1 = 0
    if(controllerSilentTicks.get("in_1") !== null) t_in1 = controllerSilentTicks.get("in_1")
