// ============================================================================
//  PORTED FROM PRODUCTION (openHAB 3 on the factory Pi) 2026-08-11.
//  Source: harvOH3-2026 commits 53a58fc + aa31282.
//
//  Two things this brings that OH5 did not have:
//    * the defaults auto-seeding (NULL -> factory value, then propagated to
//      every tunnel), which system_defaults_enhancement_plan.md still calls
//      'planned' but which has been running in production for days;
//    * the 'Startup fallback after rules model loaded' rule, because the
//      trigger is 'SystemStarting changed to OFF' and that never fires if the
//      item was NULL at boot.
//
//  RENAMED for OH5: production's *_timer_missed_actinon_value items are
//  spelled *_timer_missed_action_value here. Both systems are internally
//  consistent; OH5 keeps the corrected spelling.
//
//  SEED VALUE DISCREPANCY, unresolved: production seeds missed-action = 7,
//  while system_defaults_enhancement_plan.md and CLAUDE.md say 10. Production's
//  7 is kept below for parity with the system OH5 is meant to replace. It only
//  applies when the item is NULL -- a restored value always wins.
//
//  SAFE IN READ-ONLY MODE: the seeding block uses postUpdate only, never
//  sendCommand, so it cannot reach MQTT. (The sendCommand(OFF) calls on
//  gTnlLights/gBtnLights below are pre-existing and inert while mqtt.things
//  has its commandTopics stripped.)
// ============================================================================
// https://community.openhab.org/t/what-is-the-best-method-to-start-executing-the-rules-when-all-bindings-are-loaded/5815/2

var Timer startedTimer = null
var Timer delayUpdateTimer = null
var Boolean startupFallbackIssued = false

rule "Init Items on startup" 
when System started 
then 
logInfo("system_started", "on_startup.rules executed")
      // if not yet initialized or restored

    // tnl_Timers_Set_Default_Setpoint.postUpdate(110)   // send a default value
    // tnl_Timers_Set_Default_Setpoint_sw.sendCommand(OFF)


    // gTunnelTimerEnable.allMembers.forEach [ item | item.sendCommand(OFF) ]
    // gTunnelTimerSetpoints.allMembers.forEach [ item | item.postUpdate(110) ]
    // tnl_Timers_Set_Default_Setpoint_sw.sendCommand(OFF)
    // gTnlLights.allMembers.forEach [ item | item.sendCommand(OFF) ]
    // gBtnLights.allMembers.forEach [ item | item.sendCommand(OFF) ]
    
    // delayUpdateTimer = createTimer(now.plusMinutes(1), [| .....   ])
end

// This rule are for dealyed Init Items on startup Switch!
rule "System Started"
when
    System started
then
    startupFallbackIssued = true
    SystemStarting.sendCommand(ON)
    startedTimer = createTimer(now.plusMinutes(1), [| SystemStarting.sendCommand(OFF)])
end

rule "Startup fallback after rules model loaded"
when
    Time cron "0 0/1 * * * ?"
then
    if(startupFallbackIssued == false && (SystemStarting.state == NULL || SystemStarting.state == UNDEF)) {
        startupFallbackIssued = true
        logInfo("delayedOnStartup", "SystemStarting was NULL after rules loaded; triggering startup initialization")
        SystemStarting.postUpdate(OFF)
    }
end

rule "Rule that should not run until bindings are loaded"
when
   Item SystemStarting changed to OFF
then
    if(SystemStarting.state == OFF) {
    // gTunnelTimerCurrentValues.allMembers.forEach [ item | item.postUpdate(110) ] //! set the  tnl_Timers_Default_Value here
    // gTunnelTimerCurrentValues.allMembers.forEach [ item | item.postUpdate(tnl_Timers_Default_Value.state as DecimalType) ] 
    // gTunnelTimerEnable.allMembers.forEach [ item | item.sendCommand(OFF) ]
    // gTunnelTimerEnable.allMembers.forEach [ item | item.postUpdate(OFF) ]
    // tnl_Timers_Default_Value.postUpdate(110)
    // gTunnelTimerSetpoints.allMembers.forEach [ item | item.postUpdate(110) ] // no need from this - it is persisted in the DB
    // gTunnelTimerSetpoints.allMembers.forEach [ item | item.postUpdate(tnl_Timers_Default_Value.state as DecimalType) ] // not working...???
    // tnl_Timers_Set_Default_Setpoint_sw.sendCommand(OFF)
    // tnl_Timers_Set_Default_Setpoint_sw.postUpdate(ON)
    oneMinuteTriggerSwitch.sendCommand(OFF)
    gTnlLights.allMembers.forEach [ item | item.sendCommand(OFF) ]
    gBtnLights.allMembers.forEach [ item | item.sendCommand(OFF) ]

    var Boolean seededDefaults = false
    var Boolean seededTunnelValues = false

    var Number defaultDrying = 120
    if(default_tnl_timer_value.state == NULL || default_tnl_timer_value.state == UNDEF) {
        default_tnl_timer_value.postUpdate(defaultDrying)
        seededDefaults = true
    } else {
        defaultDrying = default_tnl_timer_value.state as DecimalType
    }

    var Number defaultMissedAction = 7
    if(default_tnl_timer_missed_action_value.state == NULL || default_tnl_timer_missed_action_value.state == UNDEF) {
        default_tnl_timer_missed_action_value.postUpdate(defaultMissedAction)
        seededDefaults = true
    } else {
        defaultMissedAction = default_tnl_timer_missed_action_value.state as DecimalType
    }

    var Number defaultExtendedDrying = 30
    if(default_tnl_timer_extendedDryingTime_value.state == NULL || default_tnl_timer_extendedDryingTime_value.state == UNDEF) {
        default_tnl_timer_extendedDryingTime_value.postUpdate(defaultExtendedDrying)
        seededDefaults = true
    } else {
        defaultExtendedDrying = default_tnl_timer_extendedDryingTime_value.state as DecimalType
    }

    if(default_tnl_warn_timer_value.state == NULL || default_tnl_warn_timer_value.state == UNDEF) {
        default_tnl_warn_timer_value.postUpdate(10)
        seededDefaults = true
    }

    if(default_tnl_temperature_alarm_value.state == NULL || default_tnl_temperature_alarm_value.state == UNDEF) {
        default_tnl_temperature_alarm_value.postUpdate(86.0)
        seededDefaults = true
