    }
    if(tnl_17_timer_missed_action_value.state == NULL || tnl_17_timer_missed_action_value.state == UNDEF) {
        tnl_17_timer_missed_action_value.postUpdate(defaultMissedAction)
        seededTunnelValues = true
    }
    if(tnl_17_timer_extendedDryingTime_value.state == NULL || tnl_17_timer_extendedDryingTime_value.state == UNDEF) {
        tnl_17_timer_extendedDryingTime_value.postUpdate(defaultExtendedDrying)
        seededTunnelValues = true
    }
    if(tnl_17_current_timer_value.state == NULL || tnl_17_current_timer_value.state == UNDEF) {
        tnl_17_current_timer_value.postUpdate(tnl_17_drying)
        seededTunnelValues = true
    }

    var Number tnl_18_drying = defaultDrying
    if(tnl_18_timer_default_value.state == NULL || tnl_18_timer_default_value.state == UNDEF) {
        tnl_18_timer_default_value.postUpdate(defaultDrying)
        seededTunnelValues = true
    } else {
        tnl_18_drying = tnl_18_timer_default_value.state as DecimalType
    }
    if(tnl_18_timer_missed_action_value.state == NULL || tnl_18_timer_missed_action_value.state == UNDEF) {
        tnl_18_timer_missed_action_value.postUpdate(defaultMissedAction)
        seededTunnelValues = true
    }
    if(tnl_18_timer_extendedDryingTime_value.state == NULL || tnl_18_timer_extendedDryingTime_value.state == UNDEF) {
        tnl_18_timer_extendedDryingTime_value.postUpdate(defaultExtendedDrying)
        seededTunnelValues = true
    }
    if(tnl_18_current_timer_value.state == NULL || tnl_18_current_timer_value.state == UNDEF) {
        tnl_18_current_timer_value.postUpdate(tnl_18_drying)
        seededTunnelValues = true
    }

    if(seededDefaults) {
        logInfo("delayedOnStartup", "Seeded missing global tunnel defaults")
    }
    if(seededTunnelValues) {
        logInfo("delayedOnStartup", "Seeded missing per-tunnel timer defaults")
    }

    logInfo("delayedOnStartup", "Delayed OnStartUp Init Items rule executed")        // rule logic
    }
end



