// ============================================================================
//  system_warning.rules -- the one line that appears on every page
// ============================================================================
//  GENERATED by make_system_health.py -- edit that, not this file.
//
//  🚨 THIS FILE ONLY READS.  It writes systemWarningActive and systemWarningText
//  and nothing else.  It does not gate, delay, clear or feed the 86 C overheat
//  alarm -- it DISPLAYS it, first in the priority list, and displaying is purely
//  additive.  A liveness message must never be able to crowd ПРЕГРЯВАНЕ off the
//  banner, which is exactly why the order below is fixed and not by recency.
//
//  PRIORITY, worst first:
//    1. overheat                     safety, always first
//    2. upstream link loss           plant-wide: the buttons are dead too
//    3. probe not responding         a technician job
//    4. sustained sensor fault       a technician job
//    5. a single silent controller   one tunnel blind
//    6. flap fault                   mechanical, never urgent in the same way
//
//  ⚠️  TRIGGERED ON EVERY SOURCE ITEM, not only on the minute tick, and this is a
//  correctness fix rather than a refinement.  Both this rule and
//  controller_liveness.rules fired on `oneMinuteTriggerSwitch changed`, and openHAB
//  does not guarantee the order two rules on the same trigger run in.  Measured on
//  OH5 2026-08-26: liveness latched scope=DEVICES while the banner, having already
//  run that tick, still displayed the lower-priority flap message -- and on another
//  tick it would have been right, which is worse than being reliably wrong.
//
//  Triggering on the sources removes the ordering dependence entirely AND makes the
//  banner update the instant something changes instead of up to a minute later.  For
//  ПРЕГРЯВАНЕ that difference is the whole point.  The tick is kept as a heartbeat
//  and System started as the seed, so the Items can never sit at NULL with the
//  banner invisible -- see the header of system_warning.items for why that matters
//  more here than anywhere else.

rule "System warning banner"
when
    Item anyTemperatureAlarm changed or
    Item controllerLinkScope changed or
    Item controllerLinkText changed or
    Item anyTemperatureProbeDead changed or
    Item anyTemperatureSensorFault changed or
    Item anyFlapFault changed or
    Item oneMinuteTriggerSwitch changed or
    System started
then
    var String txt = ""

    // ---- 1. safety, always first ----
    if(anyTemperatureAlarm.state == ON) txt = "⚠ ПРЕГРЯВАНЕ — проверете тунелите незабавно"

    // ---- 2. upstream link loss: plant-wide, and the buttons are dead too ----
    if(txt == "" && (controllerLinkScope.state.toString == "BROKER" ||
                     controllerLinkScope.state.toString == "ALL" ||
                     controllerLinkScope.state.toString == "IN_SIDE" ||
                     controllerLinkScope.state.toString == "OUT_SIDE" ||
                     controllerLinkScope.state.toString == "MANY")) {
        txt = "⚠ " + controllerLinkText.state.toString
    }

    // ---- 3. the probe is not responding on both channels ----
    if(txt == "" && anyTemperatureProbeDead.state == ON) txt = "⚠ Сензор не отговаря — свържете се с техническата поддръжка"

    // ---- 4. a sensor has been untrusted for five minutes ----
    if(txt == "" && anyTemperatureSensorFault.state == ON) txt = "⚠ Отказ на сензор — свържете се с техническата поддръжка"

    // ---- 5. a silent controller: that tunnel is blind ----
    //  🚨 The wording is deliberate.  A controller that has stopped answering takes
    //  its tunnel's overheat protection with it -- that is `019` 6's 'blind' state
    //  arriving by accident instead of by declaration, and the operator has to be
    //  told which one it is, not merely that a device is offline.
    if(txt == "" && controllerLinkScope.state.toString == "DEVICES") {
        var int nSilent = 0
        if(controllerSilentCount.state instanceof DecimalType) nSilent = (controllerSilentCount.state as DecimalType).intValue
        var String tail = " — тунелът е без защита от прегряване"
        if(nSilent > 1) tail = " — тунелите са без защита от прегряване"
        txt = "⚠ " + controllerLinkText.state.toString + tail
    }

    // ---- 6. flaps ----
    if(txt == "" && anyFlapFault.state == ON) txt = "⚠ Неизправност по клапите"

    // ---- write, unconditionally enough that NULL can never hide the banner ----
    if(txt == "") {
        if(systemWarningActive.state != OFF) systemWarningActive.postUpdate(OFF)
        if(systemWarningText.state.toString != "") systemWarningText.postUpdate("")
    } else {
        if(systemWarningActive.state != ON) systemWarningActive.postUpdate(ON)
        if(systemWarningText.state.toString != txt) systemWarningText.postUpdate(txt)
    }
end
