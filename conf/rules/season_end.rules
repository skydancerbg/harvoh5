// ============================================================================
//  season_end.rules -- КРАЙ НА СЕЗОНА
// ============================================================================
//  GENERATED by make_generated_rules.py -- edit that, not this file.
//  Variant: OH5 dev instance
//
//  The counterpart to season_start.rules, and deliberately NOT its twin:
//
//      season start = prepare and zero   (seeds globals, resets every timer)
//      season end   = STOP and RECORD    (stops everything, changes no value)
//
//  Nothing is reseeded here.  The timers are left exactly as the season
//  finished, because that final state is data.  They get reset at the next
//  season start anyway.
//
//  Why a declaration at all, when the last cart cycle is already in the data:
//  it separates "the season is over" from "a gap" AT THE TIME, which the data
//  can only do in hindsight.  A three-week wait for a spare part looks
//  identical to an ending until more data arrives.
// ============================================================================

var Timer seasonEndTimer = null

rule "SEASON END - one button"
when
    Item seasonEnd received command ON
then
    logInfo("season_end", "=== КРАЙ НА СЕЗОНА: start ===")

    var String stillRunning = ""
    if(tnl_51_btnctrl_enable.state == ON) stillRunning = stillRunning + "51 "
    if(tnl_1_btnctrl_enable.state == ON) stillRunning = stillRunning + "1 "
    if(tnl_2_btnctrl_enable.state == ON) stillRunning = stillRunning + "2 "
    if(tnl_3_btnctrl_enable.state == ON) stillRunning = stillRunning + "3 "
    if(tnl_4_btnctrl_enable.state == ON) stillRunning = stillRunning + "4 "
    if(tnl_5_btnctrl_enable.state == ON) stillRunning = stillRunning + "5 "
    if(tnl_6_btnctrl_enable.state == ON) stillRunning = stillRunning + "6 "
    if(tnl_7_btnctrl_enable.state == ON) stillRunning = stillRunning + "7 "
    if(tnl_8_btnctrl_enable.state == ON) stillRunning = stillRunning + "8 "
    if(tnl_9_btnctrl_enable.state == ON) stillRunning = stillRunning + "9 "
    if(tnl_10_btnctrl_enable.state == ON) stillRunning = stillRunning + "10 "
    if(tnl_11_btnctrl_enable.state == ON) stillRunning = stillRunning + "11 "
    if(tnl_12_btnctrl_enable.state == ON) stillRunning = stillRunning + "12 "
    if(tnl_13_btnctrl_enable.state == ON) stillRunning = stillRunning + "13 "
    if(tnl_14_btnctrl_enable.state == ON) stillRunning = stillRunning + "14 "
    if(tnl_15_btnctrl_enable.state == ON) stillRunning = stillRunning + "15 "
    if(tnl_16_btnctrl_enable.state == ON) stillRunning = stillRunning + "16 "
    if(tnl_17_btnctrl_enable.state == ON) stillRunning = stillRunning + "17 "
    if(tnl_18_btnctrl_enable.state == ON) stillRunning = stillRunning + "18 "

    //  Record BEFORE stopping anything, exactly as the start rule does.
    var Number prevEndCount = 0
    if(seasonEndCount.state instanceof DecimalType) {
        prevEndCount = seasonEndCount.state as DecimalType
    }
    seasonEndCount.postUpdate(prevEndCount + 1)
    seasonEndedAt.postUpdate(new DateTimeType())
    if(stillRunning != "") {
        seasonEndInfo.postUpdate("обявен край, с работещи тунели: " + stillRunning.trim())
        logWarn("season_end", "!!! season declared over while these tunnels were RUNNING: {}", stillRunning)
    } else {
        seasonEndInfo.postUpdate("обявен край, всички тунели спрени")
    }

    var String endSnap = ""
    endSnap = endSnap + "1:" + tnl_1_current_timer_value.state.toString + " "
    endSnap = endSnap + "2:" + tnl_2_current_timer_value.state.toString + " "
    endSnap = endSnap + "3:" + tnl_3_current_timer_value.state.toString + " "
    endSnap = endSnap + "4:" + tnl_4_current_timer_value.state.toString + " "
    endSnap = endSnap + "5:" + tnl_5_current_timer_value.state.toString + " "
    endSnap = endSnap + "6:" + tnl_6_current_timer_value.state.toString + " "
    endSnap = endSnap + "7:" + tnl_7_current_timer_value.state.toString + " "
    endSnap = endSnap + "8:" + tnl_8_current_timer_value.state.toString + " "
    endSnap = endSnap + "9:" + tnl_9_current_timer_value.state.toString + " "
    endSnap = endSnap + "10:" + tnl_10_current_timer_value.state.toString + " "
    endSnap = endSnap + "11:" + tnl_11_current_timer_value.state.toString + " "
    endSnap = endSnap + "12:" + tnl_12_current_timer_value.state.toString + " "
    endSnap = endSnap + "13:" + tnl_13_current_timer_value.state.toString + " "
    endSnap = endSnap + "14:" + tnl_14_current_timer_value.state.toString + " "
    endSnap = endSnap + "15:" + tnl_15_current_timer_value.state.toString + " "
    endSnap = endSnap + "16:" + tnl_16_current_timer_value.state.toString + " "
    endSnap = endSnap + "17:" + tnl_17_current_timer_value.state.toString + " "
    endSnap = endSnap + "18:" + tnl_18_current_timer_value.state.toString + " "
    seasonEndPrevTimers.postUpdate(endSnap.trim())

    //  Stop everything.  Same two steps as the start rule: the group command
    //  cascades only for tunnels that actually change, so the lamps are also
    //  forced off directly.
    gEnableTunnelsw.allMembers.forEach [ item | item.sendCommand(OFF) ]
    gTnlLights.allMembers.forEach [ item | item.sendCommand(OFF) ]
    gBtnLights.allMembers.forEach [ item | item.sendCommand(OFF) ]

    seasonActive.postUpdate(OFF)
    logInfo("season_end", "=== КРАЙ НА СЕЗОНА: done. Season {} closed, all tunnels stopped. Timers left as they finished. ===", prevEndCount + 1)
end


rule "Track the last tunnel activity"
when
    Item oneMinuteTriggerSwitch changed
then
    //  A plain fact, maintained continuously: the last minute at which any
    //  tunnel was in use.  The auto-close writes THIS as the end date rather
    //  than the calendar date it happened to notice on.
    var boolean anyOn = false
    if(tnl_51_btnctrl_enable.state == ON) anyOn = true
    if(tnl_1_btnctrl_enable.state == ON) anyOn = true
    if(tnl_2_btnctrl_enable.state == ON) anyOn = true
    if(tnl_3_btnctrl_enable.state == ON) anyOn = true
    if(tnl_4_btnctrl_enable.state == ON) anyOn = true
    if(tnl_5_btnctrl_enable.state == ON) anyOn = true
    if(tnl_6_btnctrl_enable.state == ON) anyOn = true
    if(tnl_7_btnctrl_enable.state == ON) anyOn = true
    if(tnl_8_btnctrl_enable.state == ON) anyOn = true
    if(tnl_9_btnctrl_enable.state == ON) anyOn = true
    if(tnl_10_btnctrl_enable.state == ON) anyOn = true
    if(tnl_11_btnctrl_enable.state == ON) anyOn = true
    if(tnl_12_btnctrl_enable.state == ON) anyOn = true
    if(tnl_13_btnctrl_enable.state == ON) anyOn = true
    if(tnl_14_btnctrl_enable.state == ON) anyOn = true
    if(tnl_15_btnctrl_enable.state == ON) anyOn = true
    if(tnl_16_btnctrl_enable.state == ON) anyOn = true
    if(tnl_17_btnctrl_enable.state == ON) anyOn = true
    if(tnl_18_btnctrl_enable.state == ON) anyOn = true

    if(anyOn) {
        lastTunnelActivityAt.postUpdate(new DateTimeType())
        //  Activity while the season is marked closed is a fact worth keeping:
        //  it means either they resumed after a long breakdown without pressing
        //  ПЪРВОНАЧАЛЕН ПУСК, or somebody is testing out of season.  Recorded,
        //  NOT acted on -- the rule cannot tell those two apart, and a human can.
        if(seasonActive.state == OFF) {
            seasonActivityWhileClosed.postUpdate(new DateTimeType())
        }
    }
end


rule "Close a forgotten season once the plums are gone"
when
    Time cron "0 30 23 * * ?"
then
    if(seasonActive.state != ON) {
        return;
    }
    val int m = now.getMonthValue
    val int d = now.getDayOfMonth
    if((m > 6 && m < 10) || (m == 10 && d < 15)) {
        return;          // plums may still be arriving; nothing to conclude
    }
    if(!(lastTunnelActivityAt.state instanceof DateTimeType)) {
        logWarn("season_end", "season is open past the plum window but there is no activity timestamp - not closing")
        return;
    }
    //  getZonedDateTime() is DEPRECATED on OH5 and logs a validation notice.  It
    //  is kept on purpose: it is the only accessor BOTH versions have, and
    //  production is still openHAB 3.1.0.  Switch to the modern call only after
    //  the switchover, when there is no OH3 left to keep in step.
    val lastAct = (lastTunnelActivityAt.state as DateTimeType).getZonedDateTime
    if(lastAct.isAfter(now.minusDays(7))) {
        logInfo("season_end", "season open past the plum window, but a tunnel ran within 7 days - leaving it open")
        return;
    }

    //  Both conditions hold: past the plum window AND idle for 7 days.
    //  Close the MARKER only -- never touch a tunnel from a scheduled rule.
    var Number prevEndCount = 0
    if(seasonEndCount.state instanceof DecimalType) {
        prevEndCount = seasonEndCount.state as DecimalType
    }
    seasonEndCount.postUpdate(prevEndCount + 1)
    seasonEndedAt.postUpdate(lastTunnelActivityAt.state)      // the measured last day, not today
    seasonEndInfo.postUpdate("автоматично приключен - няма работа от 7 дни след 15 октомври")
    seasonActive.postUpdate(OFF)
    logWarn("season_end", "season auto-closed: idle since {}, past the plum window. No tunnel was touched.",
            lastTunnelActivityAt.state.toString)
end


rule "Season flags - seed on startup"
when
    Item SystemStarting changed to OFF
then
    //  Same reasoning as seasonStartCount: the pages gate on these, and a NULL
    //  matches neither ON nor OFF, which would blank the rows.
    if(seasonActive.state == NULL || seasonActive.state == UNDEF) {
        seasonActive.postUpdate(OFF)
        logInfo("season_end", "seasonActive seeded to OFF")
    }
    if(seasonEndCount.state == NULL || seasonEndCount.state == UNDEF) {
        seasonEndCount.postUpdate(0)
    }
end
