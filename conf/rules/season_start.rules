// ============================================================================
//  season_start.rules -- ПЪРВОНАЧАЛЕН ПУСК ЗА СЕЗОНА, one button
// ============================================================================
//  GENERATED by make_season_start_rule.py -- edit that, not this file.
//  Variant: OH5 dev instance  (uses `missed_action`)
//
//  Replaces the eight-step procedure in handbook 4: stop every tunnel, set five
//  global setpoints one at a time, press "Global initial INIT all tunnel
//  values!", verify on another page, leave everything off.
//
//  WHAT IT DOES, and why the order is what it is
//  ---------------------------------------------
//   1. Seeds the five global setpoints ONLY where they are missing.  An existing
//      value is the technologist's and is never overwritten -- wiping real
//      tuning would be a worse failure than the one this fixes.
//   2. Logs which tunnels were running BEFORE anything is touched.  `globalInit`
//      has always overwritten running tunnels silently; this is the audit trail
//      it never had.
//   3. Disables every tunnel.  The per-tunnel rule cascades from this: button
//      action off, missed-action countdown off, both lights off.
//   4. Forces the lamps off directly as well.  Step 3 only cascades for tunnels
//      that actually CHANGED, so a tunnel already off could keep a stuck lamp.
//   5. Copies the globals into every tunnel, current timer included.  This is
//      `globalInit`'s job, done once, in the right order -- after the disable,
//      so nothing races the per-tunnel rules.
//   6. Clears every momentary switch.  They latch ON and their auto-off timers
//      are all commented out, so a switch left ON does nothing when pressed
//      again.  Clearing them here means the page is reusable.
//   7. Self-clears after 5 s, so THIS button never needs the turn-it-off-first
//      dance either.
//
//  Trigger is `received command ON`, not `changed` -- pressing an already-ON
//  switch still fires.  That is the whole of the latching problem, avoided.
//
//  End state: every tunnel OFF, every lamp off, every timer at the default.
//  The operator then starts tunnels one at a time from УПРАВЛЕНИЕ СИГНАЛИЗАЦИЯ
//  as each is heated and loaded.
// ============================================================================

var Timer seasonStartClearTimer = null

rule "SEASON START - one button"
when
    Item seasonStart received command ON
then
    logInfo("season_start", "=== ПЪРВОНАЧАЛЕН ПУСК ЗА СЕЗОНА: start ===")

    // ---- 1. seed the globals, only where missing ---------------------------
    if(default_tnl_timer_value.state == NULL || default_tnl_timer_value.state == UNDEF) {
        default_tnl_timer_value.postUpdate(120)
        logInfo("season_start", "seeded default_tnl_timer_value = 120   // основно време за сушене")
    }
    if(default_tnl_timer_missed_action_value.state == NULL || default_tnl_timer_missed_action_value.state == UNDEF) {
        default_tnl_timer_missed_action_value.postUpdate(10)
        logInfo("season_start", "seeded default_tnl_timer_missed_action_value = 10   // аларма при бездействие")
    }
    if(default_tnl_timer_extendedDryingTime_value.state == NULL || default_tnl_timer_extendedDryingTime_value.state == UNDEF) {
        default_tnl_timer_extendedDryingTime_value.postUpdate(30)
        logInfo("season_start", "seeded default_tnl_timer_extendedDryingTime_value = 30   // допълнително време")
    }
    if(default_tnl_warn_timer_value.state == NULL || default_tnl_warn_timer_value.state == UNDEF) {
        default_tnl_warn_timer_value.postUpdate(10)
        logInfo("season_start", "seeded default_tnl_warn_timer_value = 10   // жълт дисплей преди края")
    }
    if(default_tnl_temperature_alarm_value.state == NULL || default_tnl_temperature_alarm_value.state == UNDEF) {
        default_tnl_temperature_alarm_value.postUpdate(86.0)
        logInfo("season_start", "seeded default_tnl_temperature_alarm_value = 86.0   // аларма висока температура")
    }

    val Number drying   = default_tnl_timer_value.state as DecimalType
    val Number missed   = default_tnl_timer_missed_action_value.state as DecimalType
    val Number extended = default_tnl_timer_extendedDryingTime_value.state as DecimalType

    // ---- 2. record what was running before we touch it ---------------------
    var String running = ""
    if(tnl_51_btnctrl_enable.state == ON) running = running + "51 "
    if(tnl_1_btnctrl_enable.state == ON) running = running + "1 "
    if(tnl_2_btnctrl_enable.state == ON) running = running + "2 "
    if(tnl_3_btnctrl_enable.state == ON) running = running + "3 "
    if(tnl_4_btnctrl_enable.state == ON) running = running + "4 "
    if(tnl_5_btnctrl_enable.state == ON) running = running + "5 "
    if(tnl_6_btnctrl_enable.state == ON) running = running + "6 "
    if(tnl_7_btnctrl_enable.state == ON) running = running + "7 "
    if(tnl_8_btnctrl_enable.state == ON) running = running + "8 "
    if(tnl_9_btnctrl_enable.state == ON) running = running + "9 "
    if(tnl_10_btnctrl_enable.state == ON) running = running + "10 "
    if(tnl_11_btnctrl_enable.state == ON) running = running + "11 "
    if(tnl_12_btnctrl_enable.state == ON) running = running + "12 "
    if(tnl_13_btnctrl_enable.state == ON) running = running + "13 "
    if(tnl_14_btnctrl_enable.state == ON) running = running + "14 "
    if(tnl_15_btnctrl_enable.state == ON) running = running + "15 "
    if(tnl_16_btnctrl_enable.state == ON) running = running + "16 "
    if(tnl_17_btnctrl_enable.state == ON) running = running + "17 "
    if(tnl_18_btnctrl_enable.state == ON) running = running + "18 "

    if(running != "") {
        logWarn("season_start", "!!! these tunnels were RUNNING and are being reset: {}", running)
    } else {
        logInfo("season_start", "no tunnel was running")
    }

    // ---- 3. disable every tunnel (cascades to buttons and lamps) -----------
    gEnableTunnelsw.allMembers.forEach [ item | item.sendCommand(OFF) ]

    // ---- 4. and force the lamps off regardless of what changed -------------
    gTnlLights.allMembers.forEach [ item | item.sendCommand(OFF) ]
    gBtnLights.allMembers.forEach [ item | item.sendCommand(OFF) ]

    // ---- 5. copy the globals into every tunnel -----------------------------
    tnl_51_timer_default_value.postUpdate(drying)
    tnl_51_timer_missed_action_value.postUpdate(missed)
    tnl_51_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_51_current_timer_value.postUpdate(drying)
    tnl_1_timer_default_value.postUpdate(drying)
    tnl_1_timer_missed_action_value.postUpdate(missed)
    tnl_1_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_1_current_timer_value.postUpdate(drying)
    tnl_2_timer_default_value.postUpdate(drying)
    tnl_2_timer_missed_action_value.postUpdate(missed)
    tnl_2_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_2_current_timer_value.postUpdate(drying)
    tnl_3_timer_default_value.postUpdate(drying)
    tnl_3_timer_missed_action_value.postUpdate(missed)
    tnl_3_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_3_current_timer_value.postUpdate(drying)
    tnl_4_timer_default_value.postUpdate(drying)
    tnl_4_timer_missed_action_value.postUpdate(missed)
    tnl_4_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_4_current_timer_value.postUpdate(drying)
    tnl_5_timer_default_value.postUpdate(drying)
    tnl_5_timer_missed_action_value.postUpdate(missed)
    tnl_5_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_5_current_timer_value.postUpdate(drying)
    tnl_6_timer_default_value.postUpdate(drying)
    tnl_6_timer_missed_action_value.postUpdate(missed)
    tnl_6_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_6_current_timer_value.postUpdate(drying)
    tnl_7_timer_default_value.postUpdate(drying)
    tnl_7_timer_missed_action_value.postUpdate(missed)
    tnl_7_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_7_current_timer_value.postUpdate(drying)
    tnl_8_timer_default_value.postUpdate(drying)
    tnl_8_timer_missed_action_value.postUpdate(missed)
    tnl_8_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_8_current_timer_value.postUpdate(drying)
    tnl_9_timer_default_value.postUpdate(drying)
    tnl_9_timer_missed_action_value.postUpdate(missed)
    tnl_9_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_9_current_timer_value.postUpdate(drying)
    tnl_10_timer_default_value.postUpdate(drying)
    tnl_10_timer_missed_action_value.postUpdate(missed)
    tnl_10_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_10_current_timer_value.postUpdate(drying)
    tnl_11_timer_default_value.postUpdate(drying)
    tnl_11_timer_missed_action_value.postUpdate(missed)
    tnl_11_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_11_current_timer_value.postUpdate(drying)
    tnl_12_timer_default_value.postUpdate(drying)
    tnl_12_timer_missed_action_value.postUpdate(missed)
    tnl_12_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_12_current_timer_value.postUpdate(drying)
    tnl_13_timer_default_value.postUpdate(drying)
    tnl_13_timer_missed_action_value.postUpdate(missed)
    tnl_13_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_13_current_timer_value.postUpdate(drying)
    tnl_14_timer_default_value.postUpdate(drying)
    tnl_14_timer_missed_action_value.postUpdate(missed)
    tnl_14_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_14_current_timer_value.postUpdate(drying)
    tnl_15_timer_default_value.postUpdate(drying)
    tnl_15_timer_missed_action_value.postUpdate(missed)
    tnl_15_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_15_current_timer_value.postUpdate(drying)
    tnl_16_timer_default_value.postUpdate(drying)
    tnl_16_timer_missed_action_value.postUpdate(missed)
    tnl_16_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_16_current_timer_value.postUpdate(drying)
    tnl_17_timer_default_value.postUpdate(drying)
    tnl_17_timer_missed_action_value.postUpdate(missed)
    tnl_17_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_17_current_timer_value.postUpdate(drying)
    tnl_18_timer_default_value.postUpdate(drying)
    tnl_18_timer_missed_action_value.postUpdate(missed)
    tnl_18_timer_extendedDryingTime_value.postUpdate(extended)
    tnl_18_current_timer_value.postUpdate(drying)

    // ---- 6. clear the momentary switches so the page is reusable -----------
    //  postUpdate, not sendCommand: their own rules trigger on `changed` and
    //  act only on ON, so an OFF update cannot re-fire any of them.
    globalInit.postUpdate(OFF)
    enableAllTunnels.postUpdate(OFF)
    disableAllTunnels.postUpdate(OFF)
    sw_init_default_tnl_warn_timer_setpoint.postUpdate(OFF)
    sw_init_default_tnl_temperature_alarm_setpoint.postUpdate(OFF)
    tnl_51_resetTimer_sw.postUpdate(OFF)
    tnl_51_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_1_resetTimer_sw.postUpdate(OFF)
    tnl_1_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_2_resetTimer_sw.postUpdate(OFF)
    tnl_2_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_3_resetTimer_sw.postUpdate(OFF)
    tnl_3_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_4_resetTimer_sw.postUpdate(OFF)
    tnl_4_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_5_resetTimer_sw.postUpdate(OFF)
    tnl_5_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_6_resetTimer_sw.postUpdate(OFF)
    tnl_6_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_7_resetTimer_sw.postUpdate(OFF)
    tnl_7_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_8_resetTimer_sw.postUpdate(OFF)
    tnl_8_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_9_resetTimer_sw.postUpdate(OFF)
    tnl_9_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_10_resetTimer_sw.postUpdate(OFF)
    tnl_10_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_11_resetTimer_sw.postUpdate(OFF)
    tnl_11_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_12_resetTimer_sw.postUpdate(OFF)
    tnl_12_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_13_resetTimer_sw.postUpdate(OFF)
    tnl_13_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_14_resetTimer_sw.postUpdate(OFF)
    tnl_14_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_15_resetTimer_sw.postUpdate(OFF)
    tnl_15_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_16_resetTimer_sw.postUpdate(OFF)
    tnl_16_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_17_resetTimer_sw.postUpdate(OFF)
    tnl_17_set_all_to_defaults_sw.postUpdate(OFF)
    tnl_18_resetTimer_sw.postUpdate(OFF)
    tnl_18_set_all_to_defaults_sw.postUpdate(OFF)

    // ---- 7. self-clear so the button is reusable ---------------------------
    seasonStartClearTimer = createTimer(now.plusSeconds(5), [|
        seasonStart.postUpdate(OFF)
    ])

    logInfo("season_start", "=== ПЪРВОНАЧАЛЕН ПУСК: done. 18 tunnels OFF, lamps off, timers = {} min ===", drying)
end
